@model BikeStore.Web.Models.Cliente

@{
    ViewData["Title"] = "Nuevo cliente";
}

<style>
    body {
        background-color: #eef2f7;
    }
</style>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="bg-white shadow-sm rounded p-4">
            <h1 class="mb-4">Registrar cliente</h1>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <form asp-action="Crear" method="post">
                <div class="mb-3">
                    <label asp-for="Cedula" class="form-label">Cédula</label>
                    <input asp-for="Cedula" class="form-control" required />
                    <span asp-validation-for="Cedula" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Nombres" class="form-label">Nombres</label>
                    <input asp-for="Nombres" class="form-control" required />
                    <span asp-validation-for="Nombres" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Apellidos" class="form-label">Apellidos</label>
                    <input asp-for="Apellidos" class="form-control" required />
                    <span asp-validation-for="Apellidos" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Telefono" class="form-label">Teléfono</label>
                    <input asp-for="Telefono" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Correo" class="form-label">Correo</label>
                    <input asp-for="Correo" type="email" class="form-control" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Guardar cliente</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>